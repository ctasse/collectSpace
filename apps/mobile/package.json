{
  "name": "@collect/mobile",
  "version": "2.0.0",
  "private": true,
  "description": "CollectSpace 移动端（Expo / React Native）",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild -p android --no-install",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@collect/core": "workspace:*",
    "@collect/ui-tokens": "workspace:*",
    "@expo/vector-icons": "~14.0.4",
    "@pchmn/expo-material3-theme": "^1.4.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.49",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.5",
    "expo-crypto": "~14.0.2",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.7",
    "expo-image": "~2.0.4",
    "expo-linking": "~7.0.4",
    "expo-share-intent": "3.2.3",
    "expo-sharing": "~13.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.8",
    "expo-video": "~2.0.6",
    "expo-video-thumbnails": "~9.0.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-image-viewing": "^0.2.2",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-image-viewing",
          "@collect/core",
          "@collect/ui-tokens",
          "@pchmn/expo-material3-theme"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
